{
  "cloudflare": {
    "name": "Cloudflare",
    "nameserverPatterns": ["*.ns.cloudflare.com"],
    "dnsSettings": {
      "baseUrl": "https://dash.cloudflare.com/",
      "deepLinkStrategy": "none"
    },
    "capabilities": {
      "manual": true,
      "domainConnect": "unknown",
      "providerApi": "unknown"
    },
    "hostFieldStrategy": "at-symbol",
    "notes": [
      "Disable Cloudflare proxy (orange cloud) for CNAME records used in domain verification."
    ]
  },
  "godaddy": {
    "name": "GoDaddy",
    "nameserverPatterns": ["*.domaincontrol.com"],
    "dnsSettings": {
      "baseUrl": "https://dcc.godaddy.com/manage/dns",
      "deepLinkStrategy": "none"
    },
    "capabilities": {
      "manual": true,
      "domainConnect": "unknown",
      "providerApi": "unknown"
    },
    "hostFieldStrategy": "at-symbol"
  },
  "namecheap": {
    "name": "Namecheap",
    "nameserverPatterns": ["*.registrar-servers.com"],
    "dnsSettings": {
      "baseUrl": "https://ap.www.namecheap.com/Domains/DomainControlPanel/",
      "deepLinkStrategy": "none"
    },
    "capabilities": {
      "manual": true,
      "domainConnect": "unknown",
      "providerApi": "unknown"
    },
    "hostFieldStrategy": "at-symbol",
    "notes": ["Use '@' for the root domain in the Host field."]
  },
  "route53": {
    "name": "Amazon Route 53",
    "nameserverPatterns": [
      "*.awsdns-*.com",
      "*.awsdns-*.net",
      "*.awsdns-*.co.uk",
      "*.awsdns-*.org"
    ],
    "dnsSettings": {
      "baseUrl": "https://console.aws.amazon.com/route53/",
      "deepLinkStrategy": "none"
    },
    "capabilities": {
      "manual": true,
      "domainConnect": "unknown",
      "providerApi": "unknown"
    },
    "hostFieldStrategy": "at-symbol"
  },
  "porkbun": {
    "name": "Porkbun",
    "nameserverPatterns": ["*.ns.porkbun.com"],
    "dnsSettings": {
      "baseUrl": "https://porkbun.com/account/domains",
      "deepLinkStrategy": "none"
    },
    "capabilities": {
      "manual": true,
      "domainConnect": "unknown",
      "providerApi": "unknown"
    },
    "hostFieldStrategy": "at-symbol"
  },
  "ovh": {
    "name": "OVHcloud",
    "nameserverPatterns": ["*.ovh.net", "*.anycast.me"],
    "dnsSettings": {
      "baseUrl": "https://www.ovh.com/manager/",
      "deepLinkStrategy": "none"
    },
    "capabilities": {
      "manual": true,
      "domainConnect": "unknown",
      "providerApi": "unknown"
    },
    "hostFieldStrategy": "blank",
    "notes": [
      "Leave the Sub-domain field blank for root records. OVH does not accept @ at the apex."
    ]
  },
  "hetzner": {
    "name": "Hetzner",
    "nameserverPatterns": ["*.ns.hetzner.de", "*.ns.hetzner.com", "*.ns.hetzner.cloud"],
    "dnsSettings": {
      "baseUrl": "https://dns.hetzner.com/",
      "deepLinkStrategy": "none"
    },
    "capabilities": {
      "manual": true,
      "domainConnect": "unknown",
      "providerApi": "unknown"
    },
    "hostFieldStrategy": "at-symbol"
  },
  "ionos": {
    "name": "IONOS",
    "nameserverPatterns": ["*.ui-dns.com", "*.ui-dns.de", "*.ui-dns.org", "*.ui-dns.biz"],
    "dnsSettings": {
      "baseUrl": "https://my.ionos.com/domains",
      "deepLinkStrategy": "none"
    },
    "capabilities": {
      "manual": true,
      "domainConnect": "unknown",
      "providerApi": "unknown"
    },
    "hostFieldStrategy": "at-symbol"
  },
  "squarespace": {
    "name": "Squarespace Domains",
    "nameserverPatterns": ["ns*.squarespacedns.com"],
    "dnsSettings": {
      "baseUrl": "https://account.squarespace.com/domains",
      "deepLinkStrategy": "none"
    },
    "capabilities": {
      "manual": true,
      "domainConnect": "unknown",
      "providerApi": "unknown"
    },
    "hostFieldStrategy": "at-symbol",
    "notes": [
      "Domains migrated from Google Domains may still use ns-cloud-*.googledomains.com nameservers."
    ]
  },
  "google": {
    "name": "Google Cloud DNS",
    "nameserverPatterns": ["ns-cloud-*.googledomains.com"],
    "dnsSettings": {
      "baseUrl": "https://console.cloud.google.com/net-services/dns/zones",
      "deepLinkStrategy": "none"
    },
    "capabilities": {
      "manual": true,
      "domainConnect": "unknown",
      "providerApi": "unknown"
    },
    "hostFieldStrategy": "at-symbol",
    "notes": [
      "Includes domains migrated from Google Domains; manage records in the Cloud DNS console."
    ]
  },
  "gandi": {
    "name": "Gandi",
    "nameserverPatterns": ["ns-*.gandi.net"],
    "dnsSettings": {
      "baseUrl": "https://admin.gandi.net/domain",
      "deepLinkStrategy": "none"
    },
    "capabilities": {
      "manual": true,
      "domainConnect": "unknown",
      "providerApi": "unknown"
    },
    "hostFieldStrategy": "at-symbol"
  },
  "digitalocean": {
    "name": "DigitalOcean",
    "nameserverPatterns": ["ns1.digitalocean.com", "ns2.digitalocean.com", "ns3.digitalocean.com"],
    "dnsSettings": {
      "baseUrl": "https://cloud.digitalocean.com/networking/domains",
      "deepLinkStrategy": "none"
    },
    "capabilities": {
      "manual": true,
      "domainConnect": "unknown",
      "providerApi": "unknown"
    },
    "hostFieldStrategy": "at-symbol",
    "notes": [
      "DigitalOcean is a managed DNS provider, not a registrar. Delegate your domain to use it."
    ]
  }
}
