{
  "cloudflare": {
    "name": "Cloudflare",
    "nameserverPatterns": ["*.ns.cloudflare.com"],
    "dnsSettings": {
      "baseUrl": "https://dash.cloudflare.com/",
      "deepLinkStrategy": "none"
    },
    "capabilities": {
      "manual": true,
      "domainConnect": "unknown",
      "providerApi": "unknown"
    },
    "notes": [
      "Disable Cloudflare proxy (orange cloud) for CNAME records used in domain verification."
    ]
  },
  "godaddy": {
    "name": "GoDaddy",
    "nameserverPatterns": ["*.domaincontrol.com"],
    "dnsSettings": {
      "baseUrl": "https://dcc.godaddy.com/manage/dns",
      "deepLinkStrategy": "none"
    },
    "capabilities": {
      "manual": true,
      "domainConnect": "unknown",
      "providerApi": "unknown"
    }
  },
  "namecheap": {
    "name": "Namecheap",
    "nameserverPatterns": ["*.registrar-servers.com"],
    "dnsSettings": {
      "baseUrl": "https://ap.www.namecheap.com/Domains/DomainControlPanel/",
      "deepLinkStrategy": "none"
    },
    "capabilities": {
      "manual": true,
      "domainConnect": "unknown",
      "providerApi": "unknown"
    },
    "notes": ["Use '@' for the root domain in the Host field."]
  },
  "route53": {
    "name": "Amazon Route 53",
    "nameserverPatterns": [
      "*.awsdns-*.com",
      "*.awsdns-*.net",
      "*.awsdns-*.co.uk",
      "*.awsdns-*.org"
    ],
    "dnsSettings": {
      "baseUrl": "https://console.aws.amazon.com/route53/",
      "deepLinkStrategy": "none"
    },
    "capabilities": {
      "manual": true,
      "domainConnect": "unknown",
      "providerApi": "unknown"
    }
  },
  "porkbun": {
    "name": "Porkbun",
    "nameserverPatterns": ["*.ns.porkbun.com"],
    "dnsSettings": {
      "baseUrl": "https://porkbun.com/account/domains",
      "deepLinkStrategy": "none"
    },
    "capabilities": {
      "manual": true,
      "domainConnect": "unknown",
      "providerApi": "unknown"
    }
  }
}
